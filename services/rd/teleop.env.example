# Arguments for the vla_teleop supervisor unit (scripts/service_teleop.sh). Installed to
# ~/rd_ws/VLA/config/teleop.env by scripts/install_services.sh rd; edit that copy, then
#     sudo supervisorctl start vla_teleop
# The dataset and task can also be changed live on the page; crop flags only apply when the root is
# created (a resumed root keeps its own capture.json).
ROOT=outputs/datasets/tigger_bed_1
REPO_ID=local/tigger_bed_1
TASK="place tigger in the banana bed"
RESUME=1                 # append to an existing root (a new root is created either way)
SCENE_SQUARE=            # e.g. 0.75 — only used when the root is created
SIDE_SQUARE=
OPERATOR=Bryan
EXTRA_ARGS=              # anything else, e.g. "--no-gpu-sync" or "--expose-manual"
