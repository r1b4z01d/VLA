# Arguments for the vla_eval supervisor unit (scripts/service_eval.sh). Installed to
# ~/VLA/config/eval.env by scripts/install_services.sh rd; edit that copy, then
#     sudo supervisorctl start vla_eval
TASK="place tigger in the banana bed"
REMOTE=127.0.0.1:8777    # the robot's own inference server (vla_infer_server); started first if AUTO_INFER=1
AUTO_INFER=1
FPS=12
VIDEO=1                  # record the rollout video into the run directory
SCENE_SQUARE=            # leave empty: the crop comes from the served checkpoint's capture.json
SIDE_SQUARE=
EXTRA_ARGS=              # e.g. "--steps 300" or "--expose-manual"
